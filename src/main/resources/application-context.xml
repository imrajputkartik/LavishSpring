<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->


	<bean name="e1" class="com.lavish.spring.model.Employee">
		<property name="name" value="Anas" />
		<property name="gender" value="Male" />
		<property name="id" value="908" />
	</bean>
	
	<bean name="e2" class="com.lavish.spring.model.Employee">
		<constructor-arg name="name" value="Anas" />
		<constructor-arg name="gender" value="Male" />
		<constructor-arg name="id" value="908" />
	</bean>

</beans>

<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->

	<bean name="add" class="com.lavish.spring.model.Address">
		<property name="city" value="Noida" />
		<property name="state" value="UP" />
	</bean>

	<bean name="e1" class="com.lavish.spring.model.Employee">
		<property name="name" value="Anas" />
		<property name="gender" value="Male" />
		<property name="id" value="908" />
		<property name="address" ref="add" />

		<property name="list">
			<list>
				<value>123</value>
				<value>3</value>
				<value>783</value>
				<value>123</value>
				<value>9999</value>
			</list>
		</property>
		<property name="set">
			<set>
				<value>123</value>
				<value>6543</value>
				<value>983</value>
				<value>123</value>
				<value>3</value>
			</set>
		</property>
		<property name="map">
			<map>
				<entry key="1" value="ONE" />
				<entry key="2" value="TWO" />
				<entry key="3" value="THREE" />
				<entry key="5" value="FIVE" />
				<entry key="1" value="one" />
			</map>
		</property>
	</bean>


</beans>
